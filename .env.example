# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Database ---------------------------------------------------------------
# Inside Docker Compose the host is the service name "db", not localhost.
POSTGRES_USER=porua
POSTGRES_PASSWORD=porua
POSTGRES_DB=porua
DATABASE_URL=postgresql+asyncpg://porua:porua@db:5432/porua

# --- Gemini -----------------------------------------------------------------
# The model is fixed by the assessment brief.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# --- App --------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# How the LLM client behaves in tests:
#   live    - call the real API
#   replay  - use saved fixtures, fail if one is missing (default in tests)
#   record  - call the real API and save the response as a fixture
LLM_FIXTURE_MODE=live

# --- Limits (see PLAN.md section 7) -----------------------------------------
MAX_UPLOAD_BYTES=20971520
TURN_DEADLINE_SECONDS=45
TOOL_TIMEOUT_SECONDS=8
MAX_TOOL_CALLS_PER_TURN=6
MAX_AGENT_ITERATIONS=5
MAX_REPAIR_ATTEMPTS=2
